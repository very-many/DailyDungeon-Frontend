---
/**
 * Empty stand-in for `Dungeon.astro`.
 *
 * Used as the `server:defer` fallback on `/daily` so the page reserves the
 * finished board's exact footprint and nothing below it shifts when the real
 * island streams in. The markup deliberately mirrors the shell in
 * `Dungeon.astro` — same wrapper, same board vars, same panel classes — so the
 * two stay pixel-identical. The height maths lives in
 * `scripts/game/metrics.ts`.
 */
import Icon from "./Icon.astro";
import { boardVars, DEFAULT_PUZZLE_SIZE, type PuzzleSize } from "../scripts/game/metrics";

interface Props {
  /** Puzzle size to reserve space for. */
  size?: PuzzleSize;
  /** Text of the status line. */
  message?: string;
  /**
   * Reserve the touch toolbar's height as well. The real toolbar is a sibling
   * of the panel and shows on coarse pointers only, so the stub keeps the same
   * classes and hides itself with `invisible` (the box stays, nothing paints).
   */
  toolbar?: boolean;
}

const { size = DEFAULT_PUZZLE_SIZE, message = "Loading puzzle…", toolbar = true } = Astro.props;

const toolButton =
  'inline-flex items-center gap-2 border-2 px-4 py-3 text-[9px] tracking-wide';
---

<div class="flex w-full flex-col items-center">
  <div
    id="dungeon"
    aria-busy="true"
    style={boardVars(size)}
    class="flex min-h-(--board-h) w-full flex-col items-center justify-center gap-4 overflow-x-auto border-2 border-line bg-surface p-1 sm:min-h-(--board-h-sm) sm:w-auto sm:min-w-(--board-w-sm) sm:p-6"
  >
    <p
      id="dungeon-status"
      class="font-primary min-h-6 text-center text-xs text-tertiary sm:text-sm"
    >
      {message}
    </p>
    <slot />
  </div>
  {
    toolbar ? (
      <div
        id="dungeon-toolbar"
        aria-hidden="true"
        class="invisible pointer-coarse:flex hidden flex-wrap items-center justify-center gap-3 pt-4"
      >
        <span class={toolButton}>
          <Icon name="brick" class="size-4" />
          WALL
        </span>
        <span class={toolButton}>
          <Icon name="cross" class="size-4" />
          MARK
        </span>
      </div>
    ) : null
  }
</div>
