---
interface Props {
  puzzleUrl: string;
}
const { puzzleUrl } = Astro.props;

let puzzle: unknown = null;
try {
  const url = new URL(puzzleUrl, Astro.url);
  const response: Response = await fetch(url);
  if (!response.ok) {
    throw new Error(`Request failed with status ${response.status}`);
  }
  puzzle = await response.json();
} catch {
  puzzle = null;
}
---

<div
  id="dungeon"
  data-puzzle={puzzle ? JSON.stringify(puzzle) : undefined}
  class="flex flex-col items-center gap-4 p-6"
>
  <p
    id="dungeon-status"
    class={
      puzzle
        ? 'font-primary min-h-6 text-center text-sm text-slate-400'
        : 'font-primary min-h-6 text-center text-sm text-red-400'
    }
  >
    {puzzle ? 'Loading puzzle…' : 'Failed to load puzzle.'}
  </p>
</div>
{puzzle ? (
  <div
    id="dungeon-toolbar"
    class="pointer-coarse:flex hidden flex-wrap items-center justify-center gap-4 p-6 pt-0"
  >
    <button
      type="button"
      data-tool="wall"
      aria-pressed="true"
      class="font-primary cursor-pointer rounded border border-slate-700 bg-slate-900 px-4 py-3 text-xs text-slate-300 transition-colors"
    >
      🧱 Wall
    </button>
    <button
      type="button"
      data-tool="mark"
      aria-pressed="false"
      class="font-primary cursor-pointer rounded border border-slate-700 bg-slate-900 px-4 py-3 text-xs text-slate-300 transition-colors"
    >
      ✕ Mark
    </button>
  </div>
) : null}

<script src="../scripts/dungeon.ts"></script>