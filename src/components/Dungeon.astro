---
import Icon from "./Icon.astro";
import { boardVars, DEFAULT_PUZZLE_SIZE, type PuzzleSize } from "../scripts/game/metrics";

interface Props {
  puzzleUrl: string;
}
const { puzzleUrl } = Astro.props;

let puzzle: unknown = null;
try {
  const url = new URL(puzzleUrl, Astro.url);
  const response: Response = await fetch(url);
  if (!response.ok) {
    throw new Error(`Request failed with status ${response.status}`);
  }
  puzzle = await response.json();
} catch {
  puzzle = null;
}

// Reserve the board's footprint while loading (or when the fetch failed), so
// nothing below the board jumps once the grid is rendered.
function readSize(value: unknown): PuzzleSize {
  const candidate = value as Partial<PuzzleSize> | null;
  return typeof candidate?.width === "number" && typeof candidate?.height === "number"
    ? { width: candidate.width, height: candidate.height }
    : DEFAULT_PUZZLE_SIZE;
}

const size = readSize(puzzle);

const toolButton =
  'inline-flex cursor-pointer items-center gap-2 border-2 px-4 py-3 text-[9px] tracking-wide transition-colors';
---

<div class="flex w-full flex-col items-center">
  <div
    id="dungeon"
    data-puzzle={puzzle ? JSON.stringify(puzzle) : undefined}
    style={boardVars(size)}
    class="flex min-h-(--board-h) w-full flex-col items-center justify-center gap-4 overflow-x-auto border-2 border-line bg-surface p-4 shadow-panel-lg sm:min-h-(--board-h-sm) sm:w-auto sm:p-6"
  >
    <p
      id="dungeon-status"
      class={
        puzzle
          ? 'font-primary min-h-6 text-center text-xs text-tertiary sm:text-sm'
          : 'font-primary min-h-6 text-center text-xs text-mark sm:text-sm'
      }
    >
      {puzzle ? 'Loading puzzle…' : 'Failed to load puzzle.'}
    </p>
  </div>
  {
    puzzle ? (
      <div
        id="dungeon-toolbar"
        class="pointer-coarse:flex hidden flex-wrap items-center justify-center gap-3 pt-4"
      >
        <button
          type="button"
          data-tool="wall"
          aria-pressed="true"
          class:list={[toolButton, 'border-line', 'bg-elevated', 'text-tertiary']}
        >
          <Icon name="brick" class="size-4" />
          WALL
        </button>
        <button
          type="button"
          data-tool="mark"
          aria-pressed="false"
          class:list={[toolButton, 'border-line', 'bg-elevated', 'text-tertiary']}
        >
          <Icon name="cross" class="size-4" />
          MARK
        </button>
      </div>
    ) : null
  }
</div>

<script src="../scripts/dungeon.ts"></script>