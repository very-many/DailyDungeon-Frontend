---
import DungeonShell from "./DungeonShell.astro";
import { DEFAULT_PUZZLE_SIZE, type PuzzleSize } from "../scripts/game/metrics";

interface Props {
  puzzleUrl: string;
}

const { puzzleUrl } = Astro.props;

let puzzle: unknown = null;
try {
  const url = new URL(puzzleUrl, Astro.url);
  const response: Response = await fetch(url);
  if (!response.ok) {
    throw new Error(`Request failed with status ${response.status}`);
  }
  puzzle = await response.json();
} catch {
  puzzle = null;
}

// Reserve the board's footprint while loading (or when the fetch failed), so
// nothing below the board jumps once the grid is rendered.
function readSize(value: unknown): PuzzleSize {
  const candidate = value as Partial<PuzzleSize> | null;
  return typeof candidate?.width === "number" && typeof candidate?.height === "number"
    ? { width: candidate.width, height: candidate.height }
    : DEFAULT_PUZZLE_SIZE;
}

const size = readSize(puzzle);

// The shell is shared with the `slot="fallback"` placeholder on /daily and
// /seed, so the island's first paint is pixel-identical to the placeholder it
// replaces: the only step left for the user to see is the board replacing the
// status line.
---

<DungeonShell
  size={size}
  puzzle={puzzle ? JSON.stringify(puzzle) : undefined}
  error={!puzzle}
  message={puzzle ? undefined : 'Failed to load puzzle.'}
/>

<script src="../scripts/dungeon.ts"></script>