    ],
};

export type IconName = keyof typeof paths;

interface Props {
    name: IconName;
    class?: string;
}

const { name, class: className = "size-4" } = Astro.props;

const shapes: string[] = paths[name];
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
    aria-hidden="true"
    class={className}
>
    {shapes.map((d) => <path stroke-linecap="round" stroke-linejoin="round" d={d} />)}
</svg>
