---
import Icon, { type IconName } from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";

interface Instruction {
    icon: IconName;
    text: string;
}

const instructions: Instruction[] = [
    { icon: "brick", text: "Shade squares to create walls and complete the map of the dungeon." },
    { icon: "numbers", text: "Printed numbers indicate the number of walls in that row or column." },
    { icon: "temple", text: "Every unshaded square is either a hallway or part of a treasure room." },
    {
        icon: "gem",
        text: "Treasure rooms are always 3×3 with a single entrance and a single piece of treasure.",
    },
    {
        icon: "corridor",
        text: "Hallways are always one square wide. This means that, outside of treasure rooms, there will never be a 2×2 block of unshaded squares.",
    },
    { icon: "skull", text: "Every dead end contains a monster. Every monster is in a dead end." },
    { icon: "link", text: "All unshaded squares are connected into a single contiguous shape." },
    { icon: "diagonal", text: "Diagonally adjacent squares are never considered to be adjacent." },
];
---

<section class="pt-12">
    <SectionHeading label="HOW TO PLAY" />

    <ol class="grid gap-4 pt-6 sm:grid-cols-2">
        {
            instructions.map(({ icon, text }, index) => (
                <li class="relative flex items-start gap-3.5 border-2 border-line bg-surface px-4 py-4 shadow-panel">
                    <span
                        aria-hidden="true"
                        class="absolute left-4 top-0 -translate-y-1/2 bg-background px-1.5 text-[8px] leading-3 text-highlight"
                    >
                        {index + 1}
                    </span>
                    <Icon name={icon} class="mt-0.5 size-5 shrink-0 text-content" />
                    <p class="text-[8px] leading-5 text-tertiary sm:text-[9px]">{text}</p>
                </li>
            ))
        }
    </ol>
</section>