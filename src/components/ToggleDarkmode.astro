---
interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["relative self-stretch", className]} data-theme-dropdown>
    <button
        type="button"
        data-theme-button
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-label="Change theme"
        class="flex h-full cursor-pointer items-center gap-2 border-l border-line bg-elevated px-4 text-content transition-colors hover:text-highlight"
    >
        <!-- PLACEHOLDER ICON: replace with your own <img src="..."> later -->
        <span data-theme-icon aria-hidden="true" class="block size-5"></span>
        <span data-theme-label class="sr-only">System</span>
        <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-3 text-tertiary"
        >
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
        </svg>
    </button>

    <ul
        data-theme-menu
        role="listbox"
        aria-label="Theme"
        hidden
        class="absolute right-0 top-full z-50 mt-2 w-44 overflow-hidden rounded-lg border border-line bg-elevated py-1 shadow-lg"
    >
        <li role="presentation">
            <button
                type="button"
                role="option"
                aria-selected="false"
                data-theme-option="light"
                class="flex w-full cursor-pointer items-center gap-3 px-3 py-2 text-left transition-colors hover:bg-muted"
            >
                <!-- PLACEHOLDER ICON -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 shrink-0 text-content">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"></path>
                </svg>
                <span class="font-primary text-xs text-content">Light</span>
                <svg data-check xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="ml-auto size-4 text-highlight invisible">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
                </svg>
            </button>
        </li>
        <li role="presentation">
            <button
                type="button"
                role="option"
                aria-selected="false"
                data-theme-option="dark"
                class="flex w-full cursor-pointer items-center gap-3 px-3 py-2 text-left transition-colors hover:bg-muted"
            >
                <!-- PLACEHOLDER ICON -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 shrink-0 text-content">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"></path>
                </svg>
                <span class="font-primary text-xs text-content">Dark</span>
                <svg data-check xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="ml-auto size-4 text-highlight invisible">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
                </svg>
            </button>
        </li>
        <li role="presentation">
            <button
                type="button"
                role="option"
                aria-selected="false"
                data-theme-option="system"
                class="flex w-full cursor-pointer items-center gap-3 px-3 py-2 text-left transition-colors hover:bg-muted"
            >
                <!-- PLACEHOLDER ICON -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 shrink-0 text-content">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25"></path>
                </svg>
                <span class="font-primary text-xs text-content">System</span>
                <svg data-check xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="ml-auto size-4 text-highlight invisible">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
                </svg>
            </button>
        </li>
    </ul>
</div>

<script>
    import { getTheme, setTheme, type Theme } from "../scripts/misc/darkmode";

    const labels: Record<Theme, string> = {
        light: "Light",
        dark: "Dark",
        system: "System",
    };

    // PLACEHOLDER ICONS: swap these strings for <img src="..."> markup later.
    // No colour classes here so the SVGs inherit the button's currentColor.
    const icons: Record<Theme, string> = {
        light: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg>`,
        dark: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"/></svg>`,
        system: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25"/></svg>`,
    };

    // The navbar can render this component twice (desktop bar + mobile panel),
    // so every instance is wired up individually and shares the stored theme.
    const dropdowns = Array.from(document.querySelectorAll<HTMLElement>("[data-theme-dropdown]"));

    function setOpen(dropdown: HTMLElement, open: boolean): void {
        const menu = dropdown.querySelector<HTMLElement>("[data-theme-menu]");
        const button = dropdown.querySelector<HTMLButtonElement>("[data-theme-button]");
        if (menu) menu.hidden = !open;
        button?.setAttribute("aria-expanded", String(open));
    }

    function closeAll(): void {
        for (const dropdown of dropdowns) setOpen(dropdown, false);
    }

    /** Paint every instance — they all share one stored theme. */
    function render(): void {
        const theme = getTheme();

        for (const dropdown of dropdowns) {
            const label = dropdown.querySelector<HTMLElement>("[data-theme-label]");
            const icon = dropdown.querySelector<HTMLElement>("[data-theme-icon]");
            if (label) label.textContent = labels[theme];
            if (icon) icon.innerHTML = icons[theme];

            for (const option of dropdown.querySelectorAll<HTMLButtonElement>("[data-theme-option]")) {
                const selected = option.dataset.themeOption === theme;
                option.setAttribute("aria-selected", String(selected));
                option
                    .querySelector<HTMLElement>("[data-check]")
                    ?.classList.toggle("invisible", !selected);
            }
        }
    }

    for (const dropdown of dropdowns) {
        const button = dropdown.querySelector<HTMLButtonElement>("[data-theme-button]");
        const menu = dropdown.querySelector<HTMLElement>("[data-theme-menu]");
        if (!button || !menu) continue;

        button.addEventListener("click", () => {
            const open = menu.hidden === true;
            setOpen(dropdown, open);
            // Let other overlays (e.g. the mobile nav panel) close themselves.
            if (open) document.dispatchEvent(new Event("theme:open"));
        });

        for (const option of dropdown.querySelectorAll<HTMLButtonElement>("[data-theme-option]")) {
            option.addEventListener("click", () => {
                setTheme(option.dataset.themeOption as Theme);
                closeAll();
                render();
            });
        }
    }

    document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element) || !target.closest("[data-theme-dropdown]")) {
            closeAll();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            closeAll();
        }
    });

    // The mobile nav panel announces when it opens, so close the dropdown.
    document.addEventListener("nav:open", () => closeAll());

    render();
</script>