---
import Navbar from "../components/Navbar.astro";
import ToggleDarkmode from "../components/ToggleDarkmode.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>Astro Basics</title>
        <script>
            document.documentElement.classList.toggle(
                "dark",
                localStorage.theme === "dark" ||
                    (!("theme" in localStorage) &&
                        window.matchMedia("(prefers-color-scheme: dark)")
                            .matches),
            );
        </script>
    </head>
    <body class="flex min-h-dvh flex-col bg-background text-content">
        <Navbar />
        <slot />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
    }

    html {
        height: 100%;
    }

    /* The body keeps `min-h-dvh` (see the class above) so the footer can sit at
       the bottom of short pages without forcing a scrollbar. */
</style>
